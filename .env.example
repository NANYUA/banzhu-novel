# ============================================================
# Novel Reader · Local Environment Template
# ============================================================
# Usage:
#   1. Copy this file to .env
#   2. Fill in your local values
#   3. Keep .env private to your machine
#
# All items below are optional. The app works without any of them.

# ── Site Configuration ─────────────────────────────────────
# SITE_MIRRORS=https://example.com,https://mirror001.com
#   Target site mirrors (comma-separated). Default host is "https://example.com".
#   The app will not function without a real site configured.
# SITE_NAVIGATION_URL=https://example.com
#   Navigation address used to pull candidate hosts. Default is "https://example.com".
# SITE_MIRROR_PATTERNS="https?://[\\w.-]*\\d+\\.(?:com|net)"
#   Regex patterns for mirror domains (comma-separated).
#   Default matches generic mirror domains. Add site-specific patterns if needed.

# ── Notifications (Optional) ───────────────────────────────
# NOTIFY_WECHAT=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   WeCom bot URL for download/update notifications
# NOTIFY_PUSHOVER=user:xxx,token:xxx
#   Pushover notification

# ── CI / GitHub Actions (Optional) ─────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   For CI auto-release. Needs repo + workflow permissions.
#   Get from: GitHub Settings → Developer settings → Personal access tokens

# ── Development / Testing ──────────────────────────────────
# XCTEST_RANDOMIZE=1
#   Randomize test order (default: off for reproducibility)
